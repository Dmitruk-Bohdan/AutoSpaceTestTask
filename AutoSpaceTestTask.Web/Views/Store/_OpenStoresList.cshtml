@using AutoSpaceTestTask.Application.Models.Dtos
@model OpenStoreListResponseDto

@if (Model?.Items != null && Model.Items.Any())
{
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Наименование</th>
                <th>Адрес</th>
                <th>Режим работы</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var store in Model.Items)
            {
                <tr>
                    <td>@store.Name</td>
                    <td>@store.Address</td>
                    <td>
                        <button type="button"
                                class="btn btn-sm btn-info btn-store-details"
                                data-store-id="@store.StoreId">
                            Подробнее
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">
        Нет магазинов, работающих в данный момент
    </div>
}