@using AutoSpaceTestTask.Application.Models.Dtos
@using AutoSpaceTestTask.Application.Models.Dtos.StoreDtos
@model ListResponseDto<StorePreviewResponseDto>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>Schedule Today</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var store in Model.Items)
            {
                <tr>
                    <td>@store.Name</td>
                    <td>@store.Address</td>
                    <td>
                        @if (store.TodaySchedule != null && !store.TodaySchedule.IsDayOff)
                        {
                            @($"{store.TodaySchedule.OpenTime:HH\\:mm} - {store.TodaySchedule.CloseTime:HH\\:mm}")
                        }
                        else
                        {
                            <span class="text-muted">Closed</span>
                        }
                    </td>
                    <td>
                        <button type="button"
                                class="btn btn-sm btn-info btn-store-details"
                                data-store-id="@store.StoreId">
                            View Details
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>