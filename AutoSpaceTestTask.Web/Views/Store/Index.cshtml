@using AutoSpaceTestTask.Application.Models.Dtos
@model StoreListResponseDto

@{
    ViewData["Title"] = "Store Management";
}

<div class="container mt-4">
    <h2>Store Management</h2>
    
    <div class="mb-3">
        <button type="button" class="btn btn-info" id="btnOpenStores">
            Show Open Stores
        </button>
    </div>
    @await Html.PartialAsync("_StoresTable", Model.Items)
</div>

<div class="modal fade" id="productsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            
            <div class="modal-header">
                <h5 class="modal-title">
                    Products - <span id="storeName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="productsModalBody">
                <div class="text-center p-3">Loading...</div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="openStoresModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Open Stores</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="openStoresModalBody">
                <div class="text-center p-3">Loading...</div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="storeDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Store Details - <span id="storeDetailsName"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="storeDetailsModalBody">
                <div class="text-center p-3">Loading...</div>
            </div>
        </div>
    </div>
</div>

<div id="editStoreModalContainer"></div>

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/store/store-management.css")" />
    <link rel="stylesheet" href="@Url.Content("~/css/store/store-edit.css")" />
}

@section Scripts {
    <script src="@Url.Content("~/js/store/store-management.js")"></script>
    <script src="@Url.Content("~/js/store/store-edit.js")"></script>
}