@using AutoSpaceTestTask.Application.Models.Dtos
@using AutoSpaceTestTask.Application.Models.Dtos.ProductDtos
@model ListResponseDto<ProductDetailsResponseDto>

@if (Model?.Items != null && Model.Items.Any())
{
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Code</th>
                <th>Article</th>
                <th>Brand</th>
                <th>Name</th>
                <th>Group Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Items)
            {
                <tr>
                    <td>@product.Code.ToString().ToUpper()</td>
                    <td>@product.Article</td>
                    <td>@product.Brand</td>
                    <td>@product.Name</td>
                    <td>@product.GroupName</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        We apologize, no items are currently available in this store
    </div>
}